@model IEnumerable<AttendenceManagementDefinitions.DTOs.AttendenceDto>
<div class="table-container">
	<table class="table table-striped border-success table-success table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Student's Name</th>
				<th>Father's Name</th>
				<th>Father's Contact #</th>
				<th class="actions-col">Present/Absent</th>
			</tr>
		</thead>
		<tbody>
			@if (Model != null && Model.Count() > 0)
			{
				foreach (var student in Model)
				{
					<tr>
						<td>
							@student.RollNumber
						</td>
						<td>
							@student.StudentName
						</td>
						<td>
							@student.FatherName
						</td>
						<td>
							@student.FatherContact
						</td>
						<td class="text-center">
							<input type="checkbox" class="form-check-input" />
						</td>
					</tr>
				}
			}
			else
			{
				<tr>
					<td colspan="5" class="text-center">No data found</td>
				</tr>
			}
		</tbody>
	</table>
</div>
<div class="row mt-4">
	<div class="col d-flex justify-content-end">
		<button type="submit" class="btn btn-primary px-3 me-2">Submit</button>
	</div>
</div>