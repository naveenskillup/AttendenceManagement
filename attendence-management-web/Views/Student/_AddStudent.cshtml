@{
	ViewData["Title"] = "Add Student";
}
<form asp-controller="Student" asp-action="Save" method="post">
	<div class="row mb-1">
		<div class="col-3">
			<label for="first-name" class="form-label">First Name</label>
			<input type="text" class="form-control" id="first-name" name="FirstName">
		</div>
		<div class="col-3">
			<label for="last-name" class="form-label">Last Name</label>
			<input type="text" class="form-control" id="last-name" name="LastName">
		</div>
		<div class="col-3">
			<label for="class" class="form-label">Class</label>
			<select class="form-select" name="Class">
				<option selected value="7">7th</option>
				<option value="8">8th</option>
				<option value="9">9th</option>
				<option class="10">10th</option>
			</select>
		</div>
	</div>
	<div class="row mb-1">
		<div class="col-3">
			<label for="address" class="form-label">Address</label>
			<input type="text" class="form-control" id="address" name="Address">
		</div>
		<div class="col-3">
			<label for="city" class="form-label">City</label>
			<input type="text" class="form-control" id="city" name="City">
		</div>
		<div class="col-3">
			<label for="address" class="form-label">State</label>
			<select class="form-select" name="State">
				<option selected value="ts">Telangana</option>
				<option value="ap">Andhra Pradesh</option>
			</select>
		</div>
		<div class="col-3">
			<label for="profile" class="form-label">Profile</label>
			<input type="file" class="form-control" aria-label="file example" id="profile" name="Profile">
			<div class="invalid-feedback">Example invalid form file feedback</div>
		</div>
	</div>
	<div class="row">
		<div class="col-6">
			<label for="father-name" class="form-label">Father's Name</label>
			<input type="text" class="form-control" id="father-name" name="FatherName">
		</div>
		<div class="col-3">
			<label for="contact-number" class="form-label">Contact Number</label>
			<input type="text" class="form-control" id="contact-number" name="FatherMobileNumber">
		</div>
	</div>
	<div class="row mt-2">
		<div class="col d-flex justify-content-center">
			<button type="button" class="btn btn-danger  me-3">Cancel</button>
			<button type="submit" class="btn btn-primary">Submit</button>
		</div>
	</div>
</form>