@model IEnumerable<AttendenceManagementDefinitions.Teacher>
@{
	ViewData["Title"] = "Teacher";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row m-2 p-0">
	<div class="card">
		<div class="card-header">
			Add Teacher
		</div>
		<div class="card-body">
			<form>
				<div class="card card-body border-1 mb-3">
					<div class="row mb-3">
						<div class="col-6">
							<label for="first-name" class="form-label">First Name</label>
							<input type="text" class="form-control" id="first-name">
						</div>
						<div class="col-6">
							<label for="last-name" class="form-label">Last Name</label>
							<input type="text" class="form-control" id="last-name">
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-6">
							<label for="address" class="form-label">Address</label>
							<input type="text" class="form-control" id="address">
						</div>
						<div class="col-3">
							<label for="city" class="form-label">City</label>
							<input type="text" class="form-control" id="city">
						</div>
						<div class="col-3">
							<label for="address" class="form-label">State</label>
							<select class="form-select">
								<option selected value="ts">Telangana</option>
								<option value="ap">Andhra Pradesh</option>
							</select>
						</div>
					</div>
					<div class="row">
						<div class=" col-9 mb-3">
							<label for="profile" class="form-label">Profile</label>
							<input type="file" class="form-control" aria-label="file example" required id="profile">
							<div class="invalid-feedback">Example invalid form file feedback</div>
						</div>
						<div class=" col-3 mb-3">
							<label for="salary" class="form-label">Salary</label>
							<input type="text" class="form-control" id="salary">
						</div>
					</div>
				</div>
				<div class="card card-body border-1 mb-3">
					<div class="row mb-3">
						<div class="col-4">
							<label for="subject" class="form-label">Subject</label>
							<select class="form-select" id="subject">
								<option selected value="telugu">Telugu</option>
								<option value="hindi">Hindi</option>
								<option value="english">English</option>
								<option value="maths">Maths</option>
								<option value="science">Science</option>
								<option class="social">Social</option>
							</select>
						</div>
						<div class="col-4">
							<label for="class" class="form-label">Class</label>
							<select class="form-select">
								<option selected value="7">7th</option>
								<option value="8">8th</option>
								<option value="9">9th</option>
								<option class="10">10th</option>
							</select>
						</div>
						<div class="col-3 d-flex align-items-end ms-5">
							<button type="button" class="btn btn-primary">Add</button>
						</div>
					</div>
					<ul class="list-group">
						<li class="list-group-item bg-info d-flex justify-content-between">
							Telugu for 7th class
							<button class="btn btn-link text-danger text-decoration-none">X</button>
						</li>
						<li class="list-group-item bg-info d-flex justify-content-between">
							Telugu for 8th class
							<button class="btn btn-link text-danger text-decoration-none">X</button>
						</li>
						<li class="list-group-item bg-info d-flex justify-content-between">
							English for 10th class
							<button class="btn btn-link text-danger text-decoration-none">X</button>
						</li>
					</ul>
				</div>

				<div class="col-12 d-flex justify-content-between">
					<button type="button" class="col-3 btn btn-warning">Reset</button>
					<button type="button" class="col-3 btn btn-danger">Cancel</button>
					<button type="submit" class="col-3 btn btn-md btn-primary">Submit</button>
				</div>
			</form>
		</div>
	</div>
	<div class="card">
		<div class="card-header">
			Teacher
		</div>
		<div class="card-body">
			<table class="table table-bordered table-sm table-success table-striped">
				<thead>
					<tr class="table-primary">
						<th>Name</th>
						<th>Email</th>
						<td>Contact</td>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>B131195</td>
						<td>Naveen Kumar Cheruku</td>
						<td>8555007029</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</div>