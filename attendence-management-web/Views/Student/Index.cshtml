@model IEnumerable<AttendenceManagementDefinitions.Student>

@{
	ViewData["Title"] = "Students";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row m-1">
	<div class="card p-0">
		<div class="card-header">
			Students
		</div>
		<div class="card-body border-1">
			<div class="card card-body mb-3">
				@{await Html.RenderPartialAsync("_AddStudent");}
			</div>
			<table class="table table-bordered table-sm table-success table-striped">
				<thead>
					<tr class="table-primary">
						<th>Class</th>
						<th>Id</th>
						<th>Name</th>
						<th>Father's Name</th>
						<th>Father's Contact #</th>
						<th class="actions-col">Download</th>
					</tr>
				</thead>
				<tbody>
					@foreach(var student in Model){
						<tr>
							<td>@student.Class</td>
							<td>@student.Id</td>
							<td>@student.LastName</td>
							<td>@student.FatherName</td>
							<td>@student.FatherMobileNumber</td>
							<td class="text-center">
								<a href="#" class="me-3" data-bs-toggle="tooltip" title="View Attendence"><i class="bi bi-eye"></i></a>
								<a href="#" data-bs-toggle="tooltip" title="Download Attendence"><i class="bi bi-download"></i></a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

