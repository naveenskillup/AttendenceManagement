@{
	ViewData["Title"] = "Attendence";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card card-body mb-2">
	<div class="row">
		<div class="col-3">
			<label for="attendence-date" class="form-label">Attendence Date</label>
			<div class="input-group mb-3">
				<input type="text" class="form-control datepicker-input" id="attendence-date">
				<span class="input-group-text datepicker px-2">
					<i class="bi bi-calendar-date"></i>
				</span>
			</div>
		</div>
		<div class="col-3">
			<label for="class-code" class="form-label">Class</label>
			<select class="form-select" id="class-code" name="Class">
				<option value="7">7th</option>
				<option value="8">8th</option>
				<option value="9">9th</option>
				<option value="10">10th</option>
			</select>
		</div>
		<div class="col-3 input-block-inline">
			<label class="form-label d-block">Open with</label>
			<div class="d-flex mt-3">
				<div class="form-check me-3">
					<input type="radio" class="form-check-input" value="0" id="Absent" name="status" />
					<label for="absent" class="form-label">Absent</label>
				</div>
				<div class="form-check">
					<input type="radio" class="form-check-input" value="0" id="present" name="status" />
					<label for="present" class="form-label">Present</label>
				</div>
			</div>
		</div>
		<div class="col-3 d-flex align-items-start mt-4">
			<button type="button" class="btn btn-success px-3">Refresh</button>
		</div>
	</div>
</div>
<div class="table-container">
	<table class="table table-striped border-success table-success table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Student's Name</th>
				<th>Father's Name</th>
				<th>Father's Contact #</th>
				<th class="actions-col">Present/Absent</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var iterator in Enumerable.Range(0, 10))
			{
				<tr>
					<td>
						B131195
					</td>
					<td>
						Naveen Kumar Cheruku
					</td>
					<td>
						Lingaiah
					</td>
					<td>
						7287041507
					</td>
					<td class="text-center">
						<input type="checkbox" class="form-check-input" />
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
<div class="row mt-4">
	<div class="col d-flex justify-content-end">
		<button type="submit" class="btn btn-primary px-3">Submit</button>
	</div>
</div>
