@model IEnumerable<AttendenceManagementDefinitions.Teacher>
@{
	ViewData["Title"] = "Teacher";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card p-0 mb-1">
	<div class="card-header">
		Add Teacher
	</div>
	<div class="card-body">
		@{
			await Html.RenderPartialAsync("_Teacher");
		}
	</div>
</div>
<div class="card">
	<div class="card-header">
		Teachers
	</div>
	<div class="card-body p-1">
		<div class="table-container">
			<table class="table table-striped border-success table-success table-hover">
				<thead>
					<tr class="table-primary">
						<th>Name</th>
						<th>Contact #</th>
						<th>Salary</th>
						<th>Subject</th>
						<th>Address</th>
						<th class="actions-col">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.Count() > 0)
					{
						foreach (var item in Model)
						{
							<tr>
								<td>@item.LastName</td>
								<td>@item.MobileNumber</td>
								<td>@item.Salary</td>
								<td>@item.Subject</td>
								<td>@item.Address</td>
								<td>
									<div class="d-flex justify-content-center">
										<a href="#" class="me-4">
											<i class="bi bi-pen-fill"></i>
										</a>
										<a asp-controller="Teacher" asp-action="Delete" asp-route-id="@item.Id">
											<i class="bi bi-trash3-fill"></i>
										</a>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="6" class="text-center">No data found</td>
						</tr>
					}

				</tbody>
			</table>
		</div>
	</div>
</div>