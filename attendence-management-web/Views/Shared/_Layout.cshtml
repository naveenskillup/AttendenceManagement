<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AttendenceManagement</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
	<!-- sidebar -->
	<div id="sidebar">
		<nav class="nav flex-column">
			<a class="nav-link" aria-current="page" asp-controller="Home" asp-action="Index">
				<span class="nav-icon"><i class="bi bi-house"></i></span>
				<span class="nav-title">Dashboard</span>
			</a>
			<a class="nav-link active" asp-controller="ClassInfo" asp-action="Index">
				<span class="nav-icon"><i class="bi bi-book"></i> </span>
				<span class="nav-title">Classes</span>
			</a>
			<a class="nav-link active" data-bs-target="teachers" asp-controller="Teacher" asp-action="Index">
				<span class="nav-icon"><i class="bi bi-person-badge"></i></span>
				<span class="nav-title">Teachers</span>
			</a>
			<a class="nav-link active" data-bs-target="students" asp-controller="Student" asp-action="Index">
				<span class="nav-icon"><i class="bi bi-mortarboard"></i></span>
				<span class="nav-title">Students</span>
			</a>
			<a class="nav-link active" href="#">
				<span class="nav-icon"><i class="bi bi-bar-chart"></i></span>
				<span class="nav-title">Attendence</span>
			</a>
			<a class="nav-link active" href="#">
				<span class="nav-icon"><i class="bi bi-box-arrow-right"></i></span>
				<span class="nav-title">Sing out</span>
			</a>
		</nav>
	</div>
	<!-- main section -->
	<div id="main-content">
		<div class="card card-body border-1 m-1" id="main-content-body">
			@RenderBody()
		</div>
	</div>
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
