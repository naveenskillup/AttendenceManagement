@model IEnumerable<AttendenceManagementDefinitions.Teacher>
@{
	ViewData["Title"] = "Teacher";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card p-0 mb-1">
	<div class="card-header">
		Add Teacher
	</div>
	<div class="card-body">
		<form asp-controller="Teacher" asp-action="Save" method="post">
			<div class="row">
				<div class="col-4 mb-1">
					<label for="first-name" class="form-label">First Name</label>
					<input type="text" class="form-control" id="first-name" name="FirstName">
				</div>
				<div class="col-4 mb-1">
					<label for="last-name" class="form-label">Last Name</label>
					<input type="text" class="form-control" id="last-name" name="LastName">
				</div>
				<div class="col-4 mb-1">
					<label for="contact-number" class="form-label">Contact #</label>
					<input type="text" class="form-control" id="contact-number" name="MobileNumber">
				</div>
				<div class="col-4 mb-1">
					<label for="salary" class="form-label">Salary</label>
					<input type="text" class="form-control" id="salary" name="Salary">
				</div>
				<div class="col-4 mb-1">
					<label for="profile" class="form-label">Profile</label>
					<input type="file" class="form-control" aria-label="file example" id="profile" name="Profile">
					<div class="invalid-feedback">Example invalid form file feedback</div>
				</div>
				<div class="col-4 mb-1">
					<label for="subject" class="form-label">Subject</label>
					<select class="form-select" id="subject" name="Subject">
						<option value="Telugu">Telugu</option>
						<option value="Hindi">Hindi</option>
						<option value="English">English</option>
						<option value="Maths">Maths</option>
						<option value="Science">Science</option>
						<option value="Social">Social</option>
					</select>
				</div>
				<div class="col-4 mb-1">
					<label for="address" class="form-label">Address</label>
					<input type="text" class="form-control" id="address" name="Address">
				</div>
				<div class="col-4 mb-1">
					<label for="city" class="form-label">City</label>
					<input type="text" class="form-control" id="city" name="City">
				</div>
				<div class="col-4 mb-1">
					<label for="address" class="form-label">State</label>
					<select class="form-select" name="State">
						<option selected value="ts">Telangana</option>
						<option value="ap">Andhra Pradesh</option>
					</select>
				</div>
			</div>
			<div class="row mt-2">
				<div class="col d-flex justify-content-center">
					<button type="button" class="btn btn-danger  me-3">Cancel</button>
					<button type="submit" class="btn btn-primary">Submit</button>
				</div>
			</div>
		</form>
	</div>
</div>
<div class="card">
	<div class="card-header">
		Teachers
	</div>
	<div class="card-body p-1">
		<div class="table-container">
			<table class="table table-striped border-success table-success table-hover">
				<thead>
					<tr class="table-primary">
						<th>Name</th>
						<th>Contact #</th>
						<td>Salary</td>
						<td>Subject</td>
						<td>Address</td>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>@item.LastName</td>
							<td>@item.MobileNumber</td>
							<td>@item.Salary</td>
							<td>@item.Subject</td>
							<td>@item.Address</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>