@model IEnumerable<AttendenceManagementDefinitions.ClassInfo>

@{
	ViewData["Title"] = "Classes";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card mb-1">
	<div class="card-header">
		Add Class
	</div>
	<div class="card-body">
		@{ await Html.RenderPartialAsync("_Class");}
	</div>
</div>
<div class="card">
	<div class="card-header">
		Classes
	</div>
	<div class="card-body">
		<table class="table table-bordered table-sm table-success table-striped">
			<thead>
				<tr class="table-primary">
					<th>Class</th>
					<th>Teacher</th>
					<th>Number of Students</th>
					<th>Limit</th>
					<th>Section</th>
					<th class="actions-col">Actions</th>
				</tr>
			</thead>
			<tbody>
				@if(Model.Count() > 0){
					foreach (var item in Model)
					{
						<tr>
							<td>@item.Class</td>
							<td></td>
							<td></td>
							<td>@item.Limit</td>
							<td>@item.Section</td>
							<td>
								<div class="d-flex justify-content-center">
									<a href="#" class="me-4">
										<i class="bi bi-pen-fill"></i>
									</a>
									<a asp-controller="ClassInfo" asp-action="Delete" asp-route-id="@item.Id">
										<i class="bi bi-trash3-fill"></i>
									</a>
								</div>
							</td>
						</tr>
					}
				}else{
					<tr>
						<td colspan="6" class="text-center">No data found</td>
					</tr>					
				}
			</tbody>
		</table>
	</div>
</div>
