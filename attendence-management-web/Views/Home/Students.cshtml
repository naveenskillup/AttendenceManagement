
@{
    ViewData["Title"] = "Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row m-2">
	<div class="col-12 col-md-8 pe-2">
		<div class="card">
			<div class="card-header">
				Students
			</div>
			<div class="card-body">
				<table class="table table-bordered table-sm table-success table-striped">
					<thead>
						<tr class="table-primary">
							<th>Id</th>
							<th>Name</th>
							<th>Father Name</th>
							<th class="actions-col">Download</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>B131195</td>
							<td>Naveen Kumar Cheruku</td>
							<td>Lingaiah</td>
							<td class="text-center">
								<a href="#" class="me-3" data-bs-toggle="tooltip" title="View Attendence"><i class="bi bi-eye"></i></a>
								<a href="#" data-bs-toggle="tooltip" title="Download Attendence"><i class="bi bi-download"></i></a>
							</td>
						</tr>
						<tr>
							<td>B13112395</td>
							<td>Prasanna Nayakam</td>
							<td>Ramesh</td>
							<td class="text-center">
								<a href="#" class="me-3" data-bs-toggle="tooltip" title="View Attendence"><i class="bi bi-eye"></i></a>
								<a href="#" data-bs-toggle="tooltip" title="Download Attendence"><i class="bi bi-download"></i></a>
							</td>
						</tr>
						<tr>
							<td>B131185</td>
							<td>Chakri</td>
							<td>Unknown</td>
							<td class="text-center">
								<a href="#" class="me-3" data-bs-toggle="tooltip" title="View Attendence"><i class="bi bi-eye"></i></a>
								<a href="#" data-bs-toggle="tooltip" title="Download Attendence"><i class="bi bi-download"></i></a>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<div class="col-12 col-md-4 m-0 p-0">
		<div class="card">
			<div class="card-header">
				Add Student
			</div>
			<div class="card-body">
				<form>
					<div class="card card-body border-1 mb-3">
						<div class="row mb-3">
							<div class="col-6">
								<label for="first-name" class="form-label">First Name</label>
								<input type="text" class="form-control" id="first-name">
							</div>
							<div class="col-6">
								<label for="last-name" class="form-label">Last Name</label>
								<input type="text" class="form-control" id="last-name">
							</div>
						</div>
						<div class="row mb-3">
							<div class="col-6">
								<label for="id" class="form-label">Id</label>
								<input type="text" class="form-control" id="id">
							</div>
							<div class="col-6">
								<label for="class" class="form-label">Class</label>
								<select class="form-select">
									<option selected value="7">7th</option>
									<option value="8">8th</option>
									<option value="9">9th</option>
									<option class="10">10th</option>
								</select>
							</div>
						</div>
						<div class="row mb-3">
							<div class="col-6">
								<label for="address" class="form-label">Address</label>
								<input type="text" class="form-control" id="address">
							</div>
							<div class="col-3">
								<label for="city" class="form-label">City</label>
								<input type="text" class="form-control" id="city">
							</div>
							<div class="col-3">
								<label for="address" class="form-label">State</label>
								<select class="form-select">
									<option selected value="ts">Telangana</option>
									<option value="ap">Andhra Pradesh</option>
								</select>
							</div>
						</div>
						<div class=" col-12 mb-3">
							<input type="file" class="form-control" aria-label="file example" required>
							<div class="invalid-feedback">Example invalid form file feedback</div>
						</div>
					</div>
					<div class="card card-body border-1 mb-3">
						<div class="row">
							<div class="col-6">
								<label for="father-name" class="form-label">Father's Name</label>
								<input type="text" class="form-control" id="father-name">
							</div>
							<div class="col-6">
								<label for="contact-number" class="form-label">Contact Number</label>
								<input type="text" class="form-control" id="contact-number">
							</div>
						</div>
					</div>
					<div class="col-12 d-flex justify-content-between">
						<button type="button" class="col-3 btn btn-warning">Reset</button>
						<button type="button" class="col-3 btn btn-danger">Cancel</button>
						<button type="submit" class="col-3 btn btn-md btn-primary">Submit</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

