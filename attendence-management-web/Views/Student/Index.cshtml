@model IEnumerable<AttendenceManagementDefinitions.Student>

@{
	ViewData["Title"] = "Students";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card border-1 mb-1">
	<div class="card-header">
		Add Student
	</div>
	<div class="card-body">
		@{
			await Html.RenderPartialAsync("_Student");
		}
	</div>
</div>
<div class="card">
	<div class="card-header">
		Students
	</div>
	<div class="card-body p-1">
		<div class="table-container">
			<table class="table table-striped border-success table-success table-hover">
				<thead>
					<tr class="table-primary">
						<th>Class</th>
						<th>Id</th>
						<th>Name</th>
						<th>Father's Name</th>
						<th>Father's Contact #</th>
						<th class="actions-col">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if(Model.Count() > 0){
						@foreach (var student in Model)
						{
							<tr>
								<td>@student.Class</td>
								<td>@student.Id</td>
								<td>@student.LastName</td>
								<td>@student.FatherName</td>
								<td>@student.FatherMobileNumber</td>
								<td>
									<div class="d-flex justify-content-center">
										<a href="#" class="me-4">
											<i class="bi bi-pen-fill"></i>
										</a>
										<a asp-controller="Student" asp-action="Delete" asp-route-id="@student.Id">
											<i class="bi bi-trash3-fill"></i>
										</a>
									</div>
								</td>
							</tr>
						}
					}else{
						<tr>
							<td colspan="6" class="text-center">No data found</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>






