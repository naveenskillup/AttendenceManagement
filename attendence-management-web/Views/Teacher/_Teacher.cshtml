<form asp-controller="Teacher" asp-action="Save" method="post" id="submit-teacher-form">
    <div class="row">
        <div class="col-4 mb-1">
            <label for="first-name" class="form-label">First Name</label>
            <input type="text" class="form-control name" id="first-name" name="FirstName">
        </div>
        <div class="col-4 mb-1">
            <label for="last-name" class="form-label">Last Name</label>
            <input type="text" class="form-control name" id="last-name" name="LastName">
            <span class="text-danger" data-valmsg-for="LastName"></span>
        </div>
        <div class="col-4 mb-1">
            <label for="contact-number" class="form-label">Contact #</label>
            <input type="text" class="form-control mobile-number" id="contact-number" name="MobileNumber">
            <span class="text-danger" data-valmsg-for="MobileNumber"></span>
        </div>
        <div class="col-4 mb-1">
            <label for="salary" class="form-label">Salary</label>
            <div class="input-group">
                <input type="text" class="form-control integers" id="salary" name="Salary">
                <span class="input-group-text">K</span>
            </div>
            <span class="text-danger" data-valmsg-for="Salary"></span>
        </div>
        <div class="col-4 mb-1">
            <label for="profile" class="form-label">Profile</label>
            <input type="file" class="form-control" aria-label="file example" id="profile" name="Profile">
            <div class="invalid-feedback">Example invalid form file feedback</div>
        </div>
        <div class="col-4 mb-1">
            <label for="subject" class="form-label">Subject</label>
            <select class="form-select" id="subject" name="Subject">
                <option value="" selected>Select Subject</option>
                <option value="Telugu">Telugu</option>
                <option value="Hindi">Hindi</option>
                <option value="English">English</option>
                <option value="Maths">Maths</option>
                <option value="Science">Science</option>
                <option value="Social">Social</option>
            </select>
            <span class="text-danger" data-valmsg-for="Subject"></span>
        </div>
        <div class="col-4 mb-1">
            <label for="address" class="form-label">Address</label>
            <input type="text" class="form-control" id="address" name="Address">
            <span class="text-danger" data-valmsg-for="Address"></span>
        </div>
        <div class="col-4 mb-1">
            <label for="city" class="form-label">City</label>
            <input type="text" class="form-control" id="city" name="City">
        </div>
        <div class="col-4 mb-1">
            <label for="address" class="form-label">State</label>
            <select class="form-select" name="State">
                <option value="" selected>Select State</option>
                <option value="ts">Telangana</option>
                <option value="ap">Andhra Pradesh</option>
            </select>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col d-flex justify-content-center">
            <button type="button" class="btn btn-danger me-3">Reset</button>
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </div>
</form>